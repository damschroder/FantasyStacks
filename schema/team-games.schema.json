{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fantasystacks.dev/schema/team-games.schema.json",
  "title": "FantasyStacks team games",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "data"],
  "properties": {
    "schemaVersion": { "const": "1.4.0" },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gameId", "team", "opponent", "season", "week", "gameDate", "offensivePossessions", "offensivePlays"],
        "properties": {
          "gameId": { "type": "string" },
          "team": { "type": "string" },
          "opponent": { "type": "string" },
          "season": { "type": "integer" },
          "week": { "type": "integer", "minimum": 1, "maximum": 22 },
          "gameDate": { "type": "string", "format": "date" },
          "offensivePossessions": { "type": ["integer", "null"], "minimum": 0 },
          "offensivePlays": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    }
  }
}
